# WalletConnect project id from https://dashboard.walletconnect.com
WALLETCONNECT_PROJECT_ID=

# Small dedicated wallet only. Prefer VARIATIONAL_WALLET_PRIVATE_KEY_FILE.
VARIATIONAL_WALLET_PRIVATE_KEY=
# VARIATIONAL_WALLET_PRIVATE_KEY_FILE=secrets/variational_wallet_pk.txt

# Telegram approval bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram numeric user ids allowed to approve signatures.
TELEGRAM_ALLOWED_USER_IDS=

# Variational Omni uses Arbitrum One.
VARIATIONAL_WC_CHAINS=eip155:42161
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Start safe: approval messages are sent, but requests are rejected after approval.
VARIATIONAL_WC_DRY_RUN=true

# Keep disabled until typed-data signing is verified.
VARIATIONAL_WC_ALLOW_SEND_TRANSACTION=false
VARIATIONAL_WC_MAX_NATIVE_VALUE_WEI=0

VARIATIONAL_WC_APPROVAL_TIMEOUT_SEC=45
VARIATIONAL_WC_SESSION_APPROVAL_TIMEOUT_SEC=120
VARIATIONAL_WC_TELEGRAM_HTTP_TIMEOUT_SEC=20
VARIATIONAL_WC_TELEGRAM_HTTP_RETRIES=3
VARIATIONAL_WC_STORAGE_PREFIX=monk-variational-wallet

# When the browser extracts a fresh WalletConnect URI, it writes it here.
# Keeping variational-wallet running lets it pair automatically without
# manually pasting `npm start -- --uri wc:...`.
VARIATIONAL_WC_PAIRING_URI_FILE_ENABLED=true
VARIATIONAL_WC_PAIRING_URI_FILE=tools/variational-browser/runtime/walletconnect_uri.txt
VARIATIONAL_WC_PAIRING_URI_POLL_SEC=2
