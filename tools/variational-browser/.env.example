# Variational page to keep open.
VARIATIONAL_BROWSER_URL=https://omni.variational.io

# Runtime state. Profile stores the logged-in Variational session.
VARIATIONAL_BROWSER_PROFILE_DIR=tools/variational-browser/runtime/profile
VARIATIONAL_BROWSER_REQUEST_DIR=tools/variational-browser/runtime/requests
VARIATIONAL_BROWSER_SCREENSHOT_DIR=tools/variational-browser/runtime/screenshots

# EC2 normally needs headless=true unless noVNC/X11 is configured.
VARIATIONAL_BROWSER_HEADLESS=true
VARIATIONAL_BROWSER_VIEWPORT=1440x1200

# Start safe: Telegram approval is requested, but the final click is skipped.
VARIATIONAL_BROWSER_DRY_RUN=true

# Final order button. Use auto to scan enabled order buttons after setup.
# Live mode refuses broad selectors like body/html/*.
VARIATIONAL_BROWSER_CONFIRM_SELECTOR=auto
VARIATIONAL_BROWSER_CONNECT_WALLET_SELECTORS=button:has-text("Connect Wallet"),text="Connect Wallet"
VARIATIONAL_BROWSER_WALLETCONNECT_SELECTORS=text=/WalletConnect/i,button:has-text("WalletConnect"),[data-testid*="walletconnect" i],[aria-label*="WalletConnect" i]
VARIATIONAL_BROWSER_WC_COPY_SELECTORS=button:has-text("Copy link"),text=/Copy link/i,button:has-text("Copy"),[aria-label*="Copy" i],[title*="Copy" i]
VARIATIONAL_BROWSER_WC_URI_SELECTOR=
VARIATIONAL_BROWSER_AUTHENTICATE_SELECTORS=button:has-text("Authenticate"),text=/Authenticate/i,button:has-text("Sign In"),text=/Sign In/i,button:has-text("Log In"),text=/Log In/i,button:has-text("Continue")
VARIATIONAL_BROWSER_WALLET_PROMPT_SELECTORS=text=/Connect your wallet to see your positions/i,text=/Authenticate/i

# Used by generated variationalOrder requests. Keep these selectors verified
# with dry-run screenshots before disabling VARIATIONAL_BROWSER_DRY_RUN.
VARIATIONAL_BROWSER_BASE_URL=https://omni.variational.io
VARIATIONAL_BROWSER_MARKET_TAB_SELECTORS=button:has-text("Market"),[role="tab"]:has-text("Market"),text=/^Market$/
VARIATIONAL_BROWSER_BUY_SELECTORS=button:has-text("Buy"),[role="button"]:has-text("Buy"),text=/^Buy/i
VARIATIONAL_BROWSER_SELL_SELECTORS=button:has-text("Sell"),[role="button"]:has-text("Sell"),text=/^Sell/i
VARIATIONAL_BROWSER_SIZE_INPUT_SELECTORS=input[placeholder*="Size" i],input[name*="size" i],input[aria-label*="Size" i],input[type="number"],[contenteditable="true"],input
VARIATIONAL_BROWSER_REDUCE_ONLY_SELECTORS=label:has-text("Reduce Only"),[role="checkbox"]:has-text("Reduce Only"),text=/^Reduce Only$/i,input[type="checkbox"]
VARIATIONAL_BROWSER_ORDER_INPUT_TIMEOUT_MS=3000
VARIATIONAL_BROWSER_ORDER_SETUP_DELAY_MS=1200
VARIATIONAL_BROWSER_SIDE_FALLBACK_ENABLED=true
VARIATIONAL_BROWSER_BUY_FALLBACK_POINT=0.82,0.186
VARIATIONAL_BROWSER_SELL_FALLBACK_POINT=0.94,0.186
VARIATIONAL_BROWSER_SIZE_FALLBACK_ENABLED=true
VARIATIONAL_BROWSER_SIZE_FALLBACK_POINT=0.93,0.292
VARIATIONAL_BROWSER_REDUCE_ONLY_TIMEOUT_MS=2000
VARIATIONAL_BROWSER_REDUCE_ONLY_FALLBACK_ENABLED=true
VARIATIONAL_BROWSER_REDUCE_ONLY_FALLBACK_POINT=0.768,0.364
VARIATIONAL_BROWSER_CONFIRM_CANDIDATE_MIN_X_RATIO=0.70
VARIATIONAL_BROWSER_CONFIRM_CANDIDATE_MIN_Y_RATIO=0.30
VARIATIONAL_BROWSER_CONFIRM_CANDIDATE_MAX_Y_RATIO=0.60
VARIATIONAL_BROWSER_CONFIRM_CANDIDATE_LIMIT=5
VARIATIONAL_BROWSER_CONFIRM_FALLBACK_ENABLED=false
VARIATIONAL_BROWSER_CONFIRM_FALLBACK_POINT=0.844,0.431

VARIATIONAL_BROWSER_APPROVAL_TIMEOUT_SEC=120
VARIATIONAL_BROWSER_ACTION_TIMEOUT_SEC=15000
VARIATIONAL_BROWSER_PREVIEW_DELAY_MS=1000
VARIATIONAL_BROWSER_AFTER_CLICK_DELAY_MS=3000
VARIATIONAL_BROWSER_MAX_REQUEST_AGE_SEC=60
VARIATIONAL_BROWSER_CONNECT_WAIT_SEC=300
VARIATIONAL_BROWSER_CONNECTED_STABLE_MS=3000
VARIATIONAL_BROWSER_AUTHENTICATE_WAIT_SEC=15
VARIATIONAL_BROWSER_STATE_SETTLE_SEC=8
VARIATIONAL_BROWSER_REQUEST_WALLET_READY_WAIT_SEC=15

# Prefer a separate Telegram bot token from tools/variational-wallet if both
# processes are running at the same time. Telegram getUpdates is single-consumer.
VARIATIONAL_BROWSER_TELEGRAM_BOT_TOKEN=
VARIATIONAL_BROWSER_TELEGRAM_CHAT_ID=
VARIATIONAL_BROWSER_TELEGRAM_ALLOWED_USER_IDS=
