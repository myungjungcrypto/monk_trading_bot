{
  "_note": "Verified against a real Omni web-client HAR capture (2026-07-03). Values are typed placeholders; secrets redacted. The connector's built-in defaults already match this map, so shipping a map file is optional — regenerate with tools/har_extractor.py if the frontend API changes.",
  "host": "omni.variational.io",
  "endpoints": {
    "auth_signing_data": [
      {
        "method": "POST",
        "path": "/api/auth/generate_signing_data",
        "body_template": {"address": "<hex:signature-or-address>"},
        "response": "text/plain SIWE message to personal_sign (60s expiry, embeds nonce + ToS acceptance)",
        "response_status": 200
      }
    ],
    "auth_login": [
      {
        "method": "POST",
        "path": "/api/auth/login",
        "body_template": {"address": "<hex:signature-or-address>", "signed_message": "<hex-no-0x-prefix, 130 chars>"},
        "response_template": {"token": "<jwt>", "intercomUserJwt": "<jwt>"},
        "response_status": 200
      }
    ],
    "rfq": [
      {
        "method": "POST",
        "path": "/api/quotes/indicative",
        "body_template": {
          "instrument": {
            "underlying": "<str: BTC|ETH|...>",
            "instrument_type": "perpetual_future",
            "settlement_asset": "USDC",
            "funding_interval_s": 3600
          },
          "qty": "<str: base-asset quantity>"
        },
        "response_template": {
          "quote_id": "<uuid>",
          "bid": "<str>",
          "ask": "<str>",
          "mark_price": "<str>",
          "index_price": "<str>",
          "timestamp": "<iso8601>"
        },
        "response_status": 200
      }
    ],
    "order_submit": [
      {
        "method": "POST",
        "path": "/api/orders/new/market",
        "body_template": {
          "quote_id": "<uuid from rfq>",
          "side": "<str: buy|sell>",
          "max_slippage": "<float, e.g. 0.0002>",
          "is_reduce_only": "<bool>"
        },
        "response_template": {"rfq_id": "<uuid>", "take_profit_rfq_id": null, "stop_loss_rfq_id": null},
        "response_status": 200
      }
    ],
    "position": [
      {
        "method": "GET",
        "path": "/api/positions",
        "response_template": [
          {
            "position_info": {
              "instrument": {"underlying": "<str>", "instrument_type": "perpetual_future"},
              "qty": "<str, signed: >0 long, <0 short>",
              "avg_entry_price": "<str>"
            },
            "upnl": "<str>",
            "rpnl": "<str>",
            "cum_funding": "<str>"
          }
        ],
        "response_status": 200
      }
    ],
    "portfolio": [
      {
        "method": "GET",
        "path": "/api/portfolio",
        "query_keys": ["compute_margin"],
        "response_template": {"balance": "<str>", "upnl": "<str>", "margin_usage": {}},
        "response_status": 200
      }
    ],
    "funding": [
      {
        "method": "GET",
        "path": "/api/funding/v2",
        "query_keys": ["underlying", "instrument_type"],
        "response_template": {"predicted_funding_rate": "<str>", "next_funding_time": "<iso8601>", "funding_interval_s": "<int>"},
        "response_status": 200
      }
    ]
  },
  "_auth_headers": {
    "vr-connected-address": "sent on every request (wallet address)",
    "authorization": "Bearer <token from /api/auth/login> (HAR was cookie-sanitized; connector also keeps any Set-Cookie)"
  }
}
