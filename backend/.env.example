# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://monk:changeme@localhost:5432/monk_bot
# Docker Compose 사용 시 docker-compose.yml의 environment에서 자동 설정됨

# ── Admin ─────────────────────────────────────────
ADMIN_PASSWORD=admin

# ── JWT ───────────────────────────────────────────
JWT_SECRET=your-secret-key-here-change-in-production

# ── Backpack Exchange (Ed25519) ───────────────────
BACKPACK_API_KEY=
BACKPACK_SECRET_KEY=
# BACKPACK_PRIVATE_KEY=<base64_encoded_ed25519_private_key>

# ── Pacifica Exchange ─────────────────────────────
PACIFICA_API_KEY=
PACIFICA_SECRET_KEY=

# ── Extended Exchange ─────────────────────────────
EXTENDED_API_KEY=
EXTENDED_SECRET_KEY=

# ── Lighter Exchange ──────────────────────────────
LIGHTER_API_KEY=
LIGHTER_SECRET_KEY=
LIGHTER_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_BTC_MARKET_ID=1
LIGHTER_ETH_MARKET_ID=0
LIGHTER_BTC_BASE_DECIMALS=5
LIGHTER_ETH_BASE_DECIMALS=4
LIGHTER_PRICE_DECIMALS=2
LIGHTER_LIVE_TRADING_ENABLED=false

# ── Telegram Alerts ───────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TIMEOUT_SEC=8

# ── Variational WalletConnect Telegram signer ──────
WALLETCONNECT_PROJECT_ID=
VARIATIONAL_WALLET_PRIVATE_KEY_FILE=
VARIATIONAL_WALLET_PRIVATE_KEY=
VARIATIONAL_WC_CHAINS=eip155:42161
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
VARIATIONAL_WC_DRY_RUN=true
VARIATIONAL_WC_ALLOW_SEND_TRANSACTION=false
VARIATIONAL_WC_MAX_NATIVE_VALUE_WEI=0
VARIATIONAL_WC_APPROVAL_TIMEOUT_SEC=45
VARIATIONAL_WC_SESSION_APPROVAL_TIMEOUT_SEC=120

# ── Variational browser click gate ────────────────
VARIATIONAL_BROWSER_URL=https://omni.variational.io
VARIATIONAL_BROWSER_BASE_URL=https://omni.variational.io
VARIATIONAL_BROWSER_HEADLESS=true
VARIATIONAL_BROWSER_DRY_RUN=true
VARIATIONAL_BROWSER_CONFIRM_SELECTOR=
VARIATIONAL_BROWSER_MARKET_TAB_SELECTORS=button:has-text("Market"),[role="tab"]:has-text("Market"),text=/^Market$/
VARIATIONAL_BROWSER_BUY_SELECTORS=button:has-text("Buy"),[role="button"]:has-text("Buy"),text=/^Buy/i
VARIATIONAL_BROWSER_SELL_SELECTORS=button:has-text("Sell"),[role="button"]:has-text("Sell"),text=/^Sell/i
VARIATIONAL_BROWSER_SIZE_INPUT_SELECTORS=input[placeholder*="Size" i],input[name*="size" i],input[aria-label*="Size" i],input[type="number"],[contenteditable="true"],input
VARIATIONAL_BROWSER_SIDE_FALLBACK_ENABLED=true
VARIATIONAL_BROWSER_BUY_FALLBACK_POINT=0.82,0.186
VARIATIONAL_BROWSER_SELL_FALLBACK_POINT=0.94,0.186
VARIATIONAL_BROWSER_APPROVAL_TIMEOUT_SEC=45
VARIATIONAL_BROWSER_TELEGRAM_BOT_TOKEN=
VARIATIONAL_BROWSER_TELEGRAM_CHAT_ID=
VARIATIONAL_BROWSER_TELEGRAM_ALLOWED_USER_IDS=

# ── External fair price for Variational ───────────
# Median fair price from Binance/Lighter/Hyperliquid. Variational's own read
# price is intentionally not used as the decision price.
FAIR_PRICE_SOURCES=binance,lighter,hyperliquid
FAIR_PRICE_SYMBOLS=BTC,ETH
FAIR_PRICE_MIN_SOURCES=2
FAIR_PRICE_REQUEST_TIMEOUT_SEC=5
FAIR_PRICE_SOURCE_MAX_AGE_SEC=15
FAIR_PRICE_MAX_DEVIATION_BPS=500
FAIR_PRICE_BINANCE_BASE_URL=https://fapi.binance.com
FAIR_PRICE_HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
FAIR_PRICE_LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/stream

# ── Bot Defaults ──────────────────────────────────
EXECUTION_MODE=alert_only
PRIMARY_EXCHANGE=lighter
POSITION_SIZE_USD=500
LEVERAGE=3
TAKE_PROFIT_PCT=0.8
STOP_LOSS_PCT=-3.0
# 0 이하이면 시간 기반 TIMEOUT 청산을 끕니다.
MAX_HOLD_HOURS=12
MAX_OPEN_TRADES=3
DAILY_LOSS_LIMIT=-200
ZSCORE_REVERT_THRESHOLD=1.5
MIN_HOLD_MINUTES=120
ZSCORE_EXIT_MIN_PNL_PCT=0.05

# Alert/Paper virtual PNL cost assumptions (1bp = 0.01%)
TAKER_FEE_BPS=0
SLIPPAGE_BPS=1
