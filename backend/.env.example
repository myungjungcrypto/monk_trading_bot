# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://monk:changeme@localhost:5432/monk_bot
# Docker Compose 사용 시 docker-compose.yml의 environment에서 자동 설정됨

# ── Admin ─────────────────────────────────────────
ADMIN_PASSWORD=admin

# ── JWT ───────────────────────────────────────────
JWT_SECRET=your-secret-key-here-change-in-production

# ── Backpack Exchange (Ed25519) ───────────────────
BACKPACK_API_KEY=
BACKPACK_SECRET_KEY=
# BACKPACK_PRIVATE_KEY=<base64_encoded_ed25519_private_key>

# ── Pacifica Exchange ─────────────────────────────
PACIFICA_API_KEY=
PACIFICA_SECRET_KEY=

# ── Extended Exchange ─────────────────────────────
EXTENDED_API_KEY=
EXTENDED_SECRET_KEY=

# ── Lighter Exchange ──────────────────────────────
LIGHTER_API_KEY=
LIGHTER_SECRET_KEY=

# ── Bot Defaults ──────────────────────────────────
POSITION_SIZE_USD=500
LEVERAGE=3
TAKE_PROFIT_PCT=0.8
STOP_LOSS_PCT=-3.0
MAX_HOLD_HOURS=24
MAX_OPEN_TRADES=3
DAILY_LOSS_LIMIT=-200
